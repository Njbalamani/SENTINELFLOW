# SENTINELFLOW environment configuration
# Copy this file to .env and adjust the values. Settings load this file automatically.

DJANGO_SECRET_KEY=change-me-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_TRUST_X_FORWARDED_PROTO=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Leave DB_ENGINE empty to use the bundled SQLite database for local development.
# Set it to django.db.backends.postgresql for the production PostgreSQL setup.
DB_ENGINE=
DB_NAME=sentinelflow
DB_USER=sentinelflow
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

ML_ARTIFACT_DIR=ml/artifacts
