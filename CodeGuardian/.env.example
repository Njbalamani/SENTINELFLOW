# CODEGUARDIAN environment configuration
# Copy to .env and adjust. Settings load this file automatically.

DJANGO_SECRET_KEY=change-me-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_TRUST_X_FORWARDED_PROTO=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

DB_ENGINE=
DB_NAME=codeguardian
DB_USER=codeguardian
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

CG_MAX_FILE_SIZE_MB=10
CG_MAX_ZIP_SIZE_MB=25
CG_MAX_UNZIPPED_MB=100
CG_MAX_ZIP_FILES=200
CG_SCAN_TIMEOUT=60
CG_BANDIT_ENABLED=True
CG_SEMGREP_ENABLED=True

# Optional AI explanations. Without a key, deterministic explanations are generated.
CG_ENABLE_AI=False
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CG_AI_TIMEOUT=15
